DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAIN_MODEL=deepseek-v4-pro
MODEL_MAX_TOKENS=8192
MODEL_TEMPERATURE=0.2
DEFAULT_REPO_URL=https://github.com/Mengsanfen/CodePilot.git
CODEPILOT_EMBEDDED_WORKER=true
CODEPILOT_EXECUTION_BACKEND=local
CODEPILOT_RUN_TIMEOUT=1800
CODEPILOT_MAX_ATTEMPTS=3
CODEPILOT_MODEL_CALL_LIMIT=30
CODEPILOT_HOST_WORKSPACE=C:/codepilot-workspace
POSTGRES_PASSWORD=codepilot-local-only
GITHUB_TOKEN=
